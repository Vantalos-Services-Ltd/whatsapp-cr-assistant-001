#!/usr/bin/env bash
# Double-click this file to start the Vantalos Recruiter demo.
cd "$(dirname "$0")" || exit 1
clear
./start-demo.sh
echo ""
echo "───────────────────────────────────────────────"
echo "  This window can be closed — the demo keeps running."
echo "  To stop it later, run:  ./run stop"
echo "───────────────────────────────────────────────"
echo ""
