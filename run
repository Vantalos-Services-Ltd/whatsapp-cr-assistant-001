#!/usr/bin/env bash
#
# Task runner for this project.
#
# WHY THIS EXISTS
# ---------------
# A convenience wrapper so common jobs have short, memorable names, and so the
# project keeps working even if it is moved somewhere awkward: every tool is
# invoked by absolute path rather than relying on PATH lookup.
#
# (Historically this was a necessity, not a convenience — the project sat under
# a folder whose name contained a colon, and PATH is colon-delimited, so no
# tool could be found. That folder was renamed on 2026-08-25. Standard pnpm
# commands work again; this wrapper is kept because it is easier to remember.)
#
#   ./run seed                       rebuild the demo data
#   ./run message --list             who you can send a message as
#   ./run message "Danny" "text"     simulate an inbound WhatsApp message
#   ./run logs                       watch the system think (Ctrl-C to exit)
#   ./run stop                       stop everything
#   ./run status                     is it running?
#   ./run migrate                    apply database migrations
#   ./run studio                     browse the database in a GUI
#   ./run typecheck                  type-check the backend
#   ./run install                    reinstall dependencies
#
set -uo pipefail
cd "$(dirname "$0")"

BIN="$(pwd)/node_modules/.bin"
export PATH="/usr/local/opt/postgresql@16/bin:/opt/homebrew/opt/postgresql@16/bin:$PATH"

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

need_deps() {
  if [ ! -x "$BIN/tsx" ]; then
    echo -e "${RED}✗${NC} Dependencies are missing. Run:  ./run install"
    exit 1
  fi
}

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
  seed|demo:seed|reset)
    need_deps; exec "$BIN/tsx" prisma/demo-seed.ts ;;

  message|msg|demo:message)
    need_deps; exec "$BIN/tsx" scripts/demo-message.ts "$@" ;;

  logs)
    echo "Watching the backend. Press Ctrl-C to stop watching (it keeps running)."
    exec tail -f /tmp/vantalos-api.log ;;

  weblogs)
    exec tail -f /tmp/vantalos-web.log ;;

  stop)
    pids="$(lsof -ti tcp:3000 -ti tcp:3001 2>/dev/null || true)"
    if [ -n "$pids" ]; then echo "$pids" | xargs kill -9 2>/dev/null; fi
    echo -e "${GREEN}✓${NC} Stopped." ;;

  status)
    printf "  %-16s " "backend:";  curl -s http://localhost:3001/health 2>/dev/null || echo "not running"
    printf "\n  %-16s " "web console:"; code="$(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/operator/login 2>/dev/null)"; [ "$code" = "200" ] && echo "running" || echo "not running"
    printf "  %-16s " "database:"; pg_isready -q 2>/dev/null && echo "running" || echo "not running"
    printf "  %-16s " "redis:";    redis-cli ping >/dev/null 2>&1 && echo "running" || echo "not running"
    printf "  %-16s " "AI replies:"
    if grep -q '^OPENAI_API_KEY=.\+' .env 2>/dev/null; then
      echo -e "${GREEN}on${NC}"
    else
      echo -e "${YELLOW}off (no OpenAI key — see DEMO-GUIDE.md section 6)${NC}"
    fi
    echo ;;

  migrate)
    need_deps; exec "$BIN/prisma" migrate deploy ;;

  generate)
    need_deps; exec "$BIN/prisma" generate ;;

  studio)
    need_deps; echo "Opening database browser at http://localhost:5555"; exec "$BIN/prisma" studio ;;

  typecheck)
    need_deps; exec "$BIN/tsc" -p tsconfig.api.json --noEmit ;;

  test)
    need_deps; exec "$BIN/vitest" run ;;

  install)
    if command -v pnpm >/dev/null 2>&1; then exec pnpm install
    else corepack enable pnpm >/dev/null 2>&1; exec corepack pnpm install; fi ;;

  key|set-key)
    exec ./set-key.sh "$@" ;;

  compare|version)
    echo ""
    echo "  Version switching moved OUT of this script."
    echo ""
    echo "  Switching to the old version replaced this file (it only exists on the"
    echo "  new branch), leaving no way back. The switcher now lives one folder up:"
    echo ""
    echo "      '../Compare Versions.command'"
    echo ""
    echo "  Double-click it in Finder, or run:"
    echo "      \"$(cd .. && pwd)/Compare Versions.command\""
    echo ""
    echo "  Currently on: $(git branch --show-current)"
    echo ""
    ;;

  start)
    exec ./start-demo.sh "$@" ;;

  help|--help|-h|*)
    sed -n '13,30p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
